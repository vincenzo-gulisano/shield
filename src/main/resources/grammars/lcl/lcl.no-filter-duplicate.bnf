<pipeline> ::= <operator> | <operator> <pipeline>
<operator> ::= <map_noise_continuous_numeric> | <map_rir_continuous_numeric> | <map_aggregate_continuous_numeric> | <fork_continuous_numeric>
<map_noise_continuous_numeric> ::= <continuous_numeric_attribute> <percentage>
<map_rir_continuous_numeric> ::= <continuous_numeric_attribute>
<map_aggregate_continuous_numeric> ::= <continuous_numeric_attribute> <numeric_agg_fun> <window_size>
<fork_continuous_numeric> ::= <continuous_numeric_attribute> <numeric_condition> <numeric_value> <pipeline> <pipeline>
<continuous_numeric_attribute> ::= f1 | f2 | f3
<numeric_condition> ::= lt | gt
<numeric_value> ::= urir | drir
<numeric_agg_fun> ::= min | avg | max
<window_size> ::= 3 | 4 | 5 | 6 | 7 | 8 | 9 | 10
<percentage> ::= 0.01 | 0.05 | 0.10 | 0.25
